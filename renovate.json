{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "automerge": true,
  "packageRules": [
    {
      "matchDatasources": ["npm"],
      "rangeStrategy": "bump"
    },
    {
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "automergeType": "branch"
    }
  ],
  "ignorePaths": ["example/**"],
  "ignoreDeps": [
    "expo",
    "expo-application",
    "expo-crypto",
    "expo-device",
    "expo-network",
    "eslint",
    "eslint-config-expo",
    "expo-module-scripts"
  ]
}
